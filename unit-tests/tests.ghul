namespace Raster.Tests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute
    use Ghul.Pipes
    use Math = System.Math

    entry()

    @TestClass()
    class FONT_Tests is
        init() is si

        @Test()
        The_simplex_face_covers_printable_ASCII() is
            let font = FONT.simplex

            for at in 32::126 do
                assert font.glyph(cast char(at))?
                    else "no glyph for character {at}"
            od
        si

        @Test()
        A_capital_sits_on_the_baseline_and_is_as_tall_as_asked() is
            let image = IMAGE(100, 100)

            image.colour(0ub, 0ub, 0ub)
            image.text(20.0D, 70.0D, 40.0D, 0.5D, "H")

            let rows =
                (0..100)
                    |> filter(y =>
                        (0..100)
                            |> filter(x =>
                                image.pixel(x, y) !~
                                    (red = 255ub, green = 255ub, blue = 255ub))
                            |> count() > 0)
                    |> collect_array()

            assert rows[0] >= 29 /\ rows[0] <= 30 else "top at {rows[0]}"
            assert rows[rows.count - 1] >= 69 /\ rows[rows.count - 1] <= 70
                else "bottom at {rows[rows.count - 1]}"
        si

        @Test()
        A_space_is_blank_but_has_width() is
            let space = FONT.simplex.glyph(' ')

            assert space?
            assert space.strokes.count == 0
            assert space.width > 0
        si

        @Test()
        A_letter_is_drawn_from_strokes_of_at_least_two_points() is
            let letter = FONT.simplex.glyph('A')

            assert letter?
            assert letter.strokes.count > 0

            for stroke in letter.strokes do
                assert stroke.count >= 2 else "a stroke of one point draws nothing"
            od
        si
    si

    @TestClass()
    class READ_Tests is
        init() is si

        @Test()
        An_image_reads_back_as_it_was_written() is
            let written = IMAGE(30, 20)

            written.colour(10ub, 90ub, 200ub)
            written.stroke(3.0D)
            written.line(2.0D, 2.0D, 27.0D, 17.0D)

            let path = IO.Path.get_temp_file_name()

            written.write(path)

            let read = IMAGE.read(path)

            IO.File.delete(path)

            assert read.width == written.width
            assert read.height == written.height

            for y in 0..written.height do
                for x in 0..written.width do
                    assert read.pixel(x, y) =~ written.pixel(x, y)
                        else "{x}, {y} came back different"
                od
            od
        si

        @Test()
        Grey_reads_as_the_same_value_in_every_channel() is
            let image = IMAGE.read("images/grey.png")

            assert image.pixel(0, 0) =~ (red = 0ub, green = 0ub, blue = 0ub)
            assert image.pixel(1, 0) =~ (red = 64ub, green = 64ub, blue = 64ub)
            assert image.pixel(0, 1) =~
                (red = 128ub, green = 128ub, blue = 128ub)
            assert image.pixel(1, 1) =~
                (red = 255ub, green = 255ub, blue = 255ub)
        si

        @Test()
        An_index_reads_as_its_palette_entry() is
            let image = IMAGE.read("images/indexed.png")

            assert image.pixel(0, 0) =~ (red = 255ub, green = 0ub, blue = 0ub)
            assert image.pixel(1, 0) =~ (red = 0ub, green = 255ub, blue = 0ub)
            assert image.pixel(0, 1) =~ (red = 0ub, green = 0ub, blue = 255ub)
        si

        @Test()
        Alpha_is_composited_onto_the_white_an_image_starts_as() is
            let image = IMAGE.read("images/translucent.png")

            assert image.pixel(0, 0) =~ (red = 255ub, green = 0ub, blue = 0ub)
                else "an opaque pixel changed"

            let half = image.pixel(1, 0)

            assert half.green > 100ub /\ half.green < 160ub
                else "half cover did not land between the colour and white"

            assert image.pixel(0, 1) =~
                (red = 255ub, green = 255ub, blue = 255ub)
                else "a transparent pixel is not white"
        si
    si

    @TestClass()
    class TURTLE_Tests is
        init() is si

        @Test()
        A_turtle_starts_at_the_origin_facing_along_x() is
            let turtle = TURTLE(IMAGE(10, 10))

            assert turtle.x =~ 0.0D
            assert turtle.y =~ 0.0D
            assert turtle.heading =~ 0.0D
        si

        @Test()
        Going_forward_moves_the_way_it_is_facing() is
            let turtle = TURTLE(IMAGE(40, 40))

            turtle.move_to(10.0D, 10.0D)
            turtle.face(90.0D)
            turtle.forward(5.0D)

            assert Math.abs(turtle.x - 10.0D) < 0.000001D
            assert Math.abs(turtle.y - 15.0D) < 0.000001D
        si

        @Test()
        Turns_accumulate() is
            let turtle = TURTLE(IMAGE(10, 10))

            turtle.turn(90.0D)
            turtle.turn(45.0D)

            assert Math.abs(turtle.heading - 135.0D) < 0.000001D
        si

        @Test()
        A_lifted_pen_moves_without_drawing() is
            let drawn = IMAGE(40, 40)
            let skipped = IMAGE(40, 40)

            for image in [drawn, skipped] do
                image.colour(0ub, 0ub, 0ub)
            od

            let drawing = TURTLE(drawn)
            let lifted = TURTLE(skipped)

            lifted.pen_up()

            for turtle in [drawing, lifted] do
                turtle.move_to(5.0D, 20.0D)
                turtle.forward(30.0D)
            od

            assert _marked(drawn, 20, 20)
                else "the drawing turtle left no line"
            assert !_marked(skipped, 20, 20)
                else "the lifted turtle drew anyway"

            assert Math.abs(lifted.x - 35.0D) < 0.000001D
                else "the lifted turtle did not move"
        si

        _marked(image: IMAGE, x: int, y: int) -> bool =>
            image.pixel(x, y) !~ (red = 255ub, green = 255ub, blue = 255ub)
    si

    @TestClass()
    class IMAGE_Tests is
        init() is si

        // The pixel an image starts as, so a test can say what changed.
        _white(image: IMAGE, x: int, y: int) -> bool =>
            image.pixel(x, y) =~ (red = 255ub, green = 255ub, blue = 255ub)

        @Test()
        A_new_image_is_white() is
            let image = IMAGE(4, 3)

            for y in 0..3 do
                for x in 0..4 do
                    assert _white(image, x, y) else "{x}, {y} is not white"
                od
            od
        si

        @Test()
        A_view_puts_the_origin_where_it_says() is
            let image = IMAGE(100, 100)

            // y increases upwards, so the top of the range is row zero.
            image.view(0.0D, 0.0D, 10.0D, 10.0D)

            assert image.to_pixel(0.0D, 10.0D) =~ (x = 0.0D, y = 0.0D)
            assert image.to_pixel(10.0D, 0.0D) =~ (x = 100.0D, y = 100.0D)
            assert image.to_pixel(5.0D, 5.0D) =~ (x = 50.0D, y = 50.0D)
        si

        @Test()
        Without_a_view_a_position_is_already_a_pixel() is
            let image = IMAGE(20, 20)

            assert image.to_pixel(3.0D, 7.0D) =~ (x = 3.0D, y = 7.0D)
        si

        @Test()
        A_stroke_covers_its_own_line_and_stops() is
            let image = IMAGE(40, 40)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(2.0D)
            image.line(5.0D, 20.0D, 35.0D, 20.0D)

            assert !_white(image, 20, 20) else "the line did not draw"
            assert _white(image, 20, 5) else "ink far above the line"
            assert _white(image, 20, 35) else "ink far below the line"
            assert _white(image, 1, 20) else "ink beyond the start"
        si

        @Test()
        A_thicker_stroke_covers_more() is
            let thin = IMAGE(40, 40)
            let thick = IMAGE(40, 40)

            for image in [thin, thick] do
                image.colour(0ub, 0ub, 0ub)
            od

            thin.stroke(1.0D)
            thick.stroke(5.0D)

            thin.line(5.0D, 20.0D, 35.0D, 20.0D)
            thick.line(5.0D, 20.0D, 35.0D, 20.0D)

            assert _inked(thick) > _inked(thin)
                else "a wider stroke marked no more pixels"
        si

        @Test()
        A_stroke_is_antialiased() is
            let image = IMAGE(40, 40)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(1.0D)
            image.line(4.0D, 4.0D, 36.0D, 30.0D)

            let blended =
                (0..40)
                    |> map(y =>
                        (0..40)
                            |> filter(x =>
                                (let seen = image.pixel(x, y)

                                 seen.red > 0ub /\ seen.red < 255ub))
                            |> count())
                    |> reduce(0, (a, b) => a + b)

            assert blended > 0
                else "every pixel is either white or black, so nothing is blended"
        si

        _inked(image: IMAGE) -> int =>
            (0..image.height)
                |> map(y =>
                    (0..image.width)
                        |> filter(x =>
                            image.pixel(x, y) !~
                                (red = 255ub, green = 255ub, blue = 255ub))
                        |> count())
                |> reduce(0, (a, b) => a + b)

        @Test()
        A_blend_lays_part_of_the_colour_over_what_is_there() is
            let image = IMAGE(4, 4)

            image.colour(0ub, 0ub, 0ub)

            image.blend(1, 1, 0.5D)

            let half = image.pixel(1, 1)

            assert half.red > 0ub /\ half.red < 255ub
                else "half cover left the pixel white or black"

            image.blend(2, 2, 1.0D)

            assert image.pixel(2, 2) =~ (red = 0ub, green = 0ub, blue = 0ub)

            image.blend(3, 3, 0.0D)

            assert _white(image, 3, 3) else "no cover marked the pixel"
        si

        @Test()
        A_blend_outside_the_image_is_ignored() is
            let image = IMAGE(2, 2)

            image.colour(0ub, 0ub, 0ub)

            image.blend(-1, 0, 1.0D)
            image.blend(0, 5, 1.0D)

            for y in 0..2 do
                for x in 0..2 do
                    assert _white(image, x, y) else "{x}, {y} was marked"
                od
            od
        si

        @Test()
        A_filled_shape_is_solid_inside_and_clear_outside() is
            let image = IMAGE(60, 60)

            image.colour(0ub, 0ub, 0ub)

            image.fill([
                (x = 10.0D, y = 10.0D),
                (x = 50.0D, y = 10.0D),
                (x = 50.0D, y = 50.0D),
                (x = 10.0D, y = 50.0D)
            ])

            assert !_white(image, 30, 30) else "the middle is not filled"
            assert _white(image, 5, 30) else "ink outside the shape"
            assert _white(image, 55, 30) else "ink outside the shape"
        si

        @Test()
        A_shape_of_fewer_than_three_points_encloses_nothing() is
            let image = IMAGE(20, 20)

            image.colour(0ub, 0ub, 0ub)

            image.fill([(x = 2.0D, y = 2.0D), (x = 18.0D, y = 18.0D)])

            assert _inked(image) == 0 else "two points enclosed something"
        si

        @Test()
        A_line_through_points_joins_each_to_the_next() is
            let image = IMAGE(60, 60)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(2.0D)

            image.line([
                (x = 10.0D, y = 10.0D),
                (x = 50.0D, y = 10.0D),
                (x = 50.0D, y = 50.0D)
            ])

            assert !_white(image, 30, 10) else "the first leg is missing"
            assert !_white(image, 50, 30) else "the second leg is missing"
            assert _white(image, 30, 50)
                else "the shape closed itself, which it should not"
        si

        @Test()
        A_flood_fill_stops_at_a_boundary() is
            let image = IMAGE(40, 40)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(2.0D)

            image.line([
                (x = 8.0D, y = 8.0D),
                (x = 32.0D, y = 8.0D),
                (x = 32.0D, y = 32.0D),
                (x = 8.0D, y = 32.0D),
                (x = 8.0D, y = 8.0D)
            ])

            image.colour(200ub, 0ub, 0ub)

            image.flood_fill(20, 20)

            assert image.pixel(20, 20) =~
                (red = 200ub, green = 0ub, blue = 0ub)
                else "inside was not filled"

            assert _white(image, 2, 2) else "the fill escaped the boundary"
        si

        @Test()
        Text_is_as_wide_as_it_says_and_grows_with_its_height() is
            let image = IMAGE(10, 10)

            assert image.text_width(20.0D, "") =~ 0.0D

            let small = image.text_width(10.0D, "sin x")
            let large = image.text_width(20.0D, "sin x")

            assert small > 0.0D
            assert large > small
        si

        @Test()
        Text_draws_where_it_was_put() is
            let image = IMAGE(120, 60)

            image.colour(0ub, 0ub, 0ub)
            image.text(10.0D, 40.0D, 24.0D, "Ag")

            assert _inked(image) > 0 else "nothing was drawn"
            assert _white(image, 110, 55) else "ink far from the text"
        si
    si

    @TestClass()
    class CIRCLE_Tests is
        init() is si

        _white(image: IMAGE, x: int, y: int) -> bool =>
            image.pixel(x, y) =~ (red = 255ub, green = 255ub, blue = 255ub)

        _black(image: IMAGE, x: int, y: int) -> bool =>
            image.pixel(x, y) =~ (red = 0ub, green = 0ub, blue = 0ub)

        _image() -> IMAGE =>
            (let image = IMAGE(60, 60)

             image.colour(0ub, 0ub, 0ub)
             image.stroke(2.0D)

             image)

        @Test()
        A_disc_is_solid_inside_and_clear_outside() is
            let image = _image()

            image.disc(30.0D, 30.0D, 10.0D)

            assert _black(image, 30, 30) else "the centre is not filled"
            assert _black(image, 36, 30) else "inside the edge is not filled"
            assert _white(image, 30, 45) else "ink outside the disc"
        si

        @Test()
        A_circle_marks_its_edge_and_leaves_its_middle() is
            let image = _image()

            image.circle(30.0D, 30.0D, 10.0D)

            assert _white(image, 30, 30) else "the circle filled its middle"
            assert !_white(image, 39, 30) else "the edge is missing"
            assert !_white(image, 30, 20) else "the edge is missing"
            assert _white(image, 30, 45) else "ink outside the circle"
        si

        @Test()
        A_radius_is_in_user_coordinates() is
            let image = _image()

            image.view(0.0D, 0.0D, 6.0D, 6.0D)
            image.disc(3.0D, 3.0D, 1.0D)

            assert _black(image, 36, 30) else "a radius of one is not ten pixels"
            assert _white(image, 44, 30) else "a radius of one is over ten pixels"
        si

        @Test()
        An_arc_goes_counter_clockwise_from_its_first_angle() is
            let image = _image()

            image.view(0.0D, 0.0D, 60.0D, 60.0D)
            image.arc(30.0D, 30.0D, 20.0D, 270.0D, 90.0D)

            assert !_white(image, 50, 30) else "the right side is missing"
            assert _white(image, 10, 30) else "the left side was drawn"
        si

        @Test()
        An_arc_has_round_ends_and_goes_no_further() is
            let image = _image()

            image.view(0.0D, 0.0D, 60.0D, 60.0D)
            image.arc(30.0D, 30.0D, 20.0D, 0.0D, 90.0D)

            assert !_white(image, 49, 30) else "the start is missing"
            assert _white(image, 49, 36) else "the arc ran on past its start"
        si
    si

    @TestClass()
    class COLOUR_MAP_Tests is
        init() is si

        @Test()
        Each_map_starts_and_ends_where_it_says() is
            assert COLOUR_MAP.viridis(0.0D) =~ (red = 68ub, green = 1ub, blue = 84ub)
            assert COLOUR_MAP.viridis(1.0D) =~ (red = 253ub, green = 231ub, blue = 37ub)
            assert COLOUR_MAP.cool_warm(0.5D) =~ (red = 221ub, green = 221ub, blue = 221ub)
            assert COLOUR_MAP.hue(0.0D) =~ (red = 255ub, green = 0ub, blue = 0ub)
            assert COLOUR_MAP.hue(1.0D / 3.0D) =~ (red = 0ub, green = 255ub, blue = 0ub)
        si

        @Test()
        A_value_beyond_either_end_takes_that_end() is
            assert COLOUR_MAP.viridis(-3.0D) =~ COLOUR_MAP.viridis(0.0D)
            assert COLOUR_MAP.cool_warm(7.0D) =~ COLOUR_MAP.cool_warm(1.0D)
            assert COLOUR_MAP.viridis(double.na_n) =~ COLOUR_MAP.viridis(0.0D)
        si

        @Test()
        Hue_wraps() is
            assert COLOUR_MAP.hue(1.25D) =~ COLOUR_MAP.hue(0.25D)
            assert COLOUR_MAP.hue(-0.75D) =~ COLOUR_MAP.hue(0.25D)
        si

        @Test()
        A_colour_can_be_given_as_a_map_gives_it() is
            let image = IMAGE(2, 2)

            image.colour(COLOUR_MAP.viridis(1.0D))
            image.blend(0, 0, 1.0D)

            assert image.pixel(0, 0) =~ COLOUR_MAP.viridis(1.0D)
        si
    si

    @TestClass()
    class AXES_Tests is
        init() is si

        @Test()
        Ticks_fall_on_round_numbers() is
            let ticks = AXES.ticks(0.0D, 10.0D, 5)

            assert ticks.count == 6 else "{ticks.count} ticks"
            assert ticks[0] =~ 0.0D
            assert ticks[5] =~ 10.0D
        si

        @Test()
        Ticks_stay_within_the_range() is
            let ticks = AXES.ticks(-1.3D, 2.7D, 8)

            assert AXES.step(-1.3D, 2.7D, 8) =~ 0.5D
            assert ticks[0] =~ -1.0D
            assert ticks[ticks.count - 1] =~ 2.5D
        si

        @Test()
        A_label_carries_as_many_places_as_the_step_needs() is
            assert AXES.label(2.0D, [0.0D, 1.0D]) =~ "2"
            assert AXES.label(0.5D, [0.0D, 0.5D]) =~ "0.5"
            assert AXES.label(0.3D - 0.1D, [0.0D, 0.1D]) =~ "0.2"
            assert AXES.label(-0.0000000001D, [0.0D, 0.1D]) =~ "0.0"
        si

        @Test()
        The_frame_is_drawn_round_the_view() is
            let image = IMAGE(100, 100)

            image.view(0.0D, 0.0D, 1.0D, 1.0D, 20.0D)

            image.colour(0ub, 0ub, 0ub)
            image.stroke(2.0D)

            AXES(image).draw()

            let white = (red = 255ub, green = 255ub, blue = 255ub)

            assert image.pixel(50, 20) !~ white else "no top edge"
            assert image.pixel(80, 50) !~ white else "no right edge"
            assert image.pixel(50, 80) !~ white else "no bottom edge"
            assert image.pixel(20, 50) !~ white else "no left edge"
            assert image.pixel(50, 50) =~ white else "ink inside the frame"
        si
    si

    @TestClass()
    class TEXT_ANCHOR_Tests is
        init() is si

        // The leftmost and rightmost columns anything was drawn in.
        _extent(image: IMAGE) -> (left: int, right: int) =>
            (let columns =
                 (0..image.width)
                     |> filter(x =>
                         (0..image.height)
                             |> filter(y =>
                                 image.pixel(x, y) !~
                                     (red = 255ub, green = 255ub, blue = 255ub))
                             |> count() > 0)
                     |> collect_array()

             (left = columns[0], right = columns[columns.count - 1]))

        _drawn(anchor: Anchor) -> (left: int, right: int) =>
            (let image = IMAGE(200, 40)

             image.colour(0ub, 0ub, 0ub)
             image.text(100.0D, 30.0D, 12.0D, "HHH", anchor)

             _extent(image))

        @Test()
        Left_text_starts_at_its_position() is
            let drawn = _drawn(Anchor.LEFT)

            assert Math.abs(drawn.left - 100) <= 4 else "starts at {drawn.left}"
        si

        @Test()
        Right_text_ends_at_its_position() is
            let drawn = _drawn(Anchor.RIGHT)

            assert Math.abs(drawn.right - 100) <= 4 else "ends at {drawn.right}"
        si

        @Test()
        Centred_text_straddles_its_position() is
            let drawn = _drawn(Anchor.CENTRE)

            assert Math.abs(drawn.left + drawn.right - 200) <= 2
                else "runs from {drawn.left} to {drawn.right}"
        si

        @Test()
        Upward_text_is_taller_than_it_is_wide() is
            let image = IMAGE(60, 200)

            image.colour(0ub, 0ub, 0ub)
            image.upward_text(40.0D, 100.0D, 12.0D, "HHHH", Anchor.CENTRE)

            let across = _extent(image)

            assert across.right - across.left < 20
                else "{across.right - across.left} pixels wide"
        si
    si
si
